from collections import deque
class SingleQueue:
    def __init__(self):
        self.queue = deque()
    def pop(self, val):
        if self.queue and self.queue[0] == val:
            self.queue.popleft()
    def push(self, val):
        while self.queue and val > self.queue[-1]:
            self.queue.pop()
        self.queue.append(val)
    def front(self):
        if self.queue:
            return self.queue[0]
        else:
            return None
        
def singleMax(nums, k):
    if k >= len(nums):
        return [max(nums)]
    sinq = SingleQueue()
    for i in range(k):
        sinq.push(nums[i])
    ans = []
    ans.append(sinq.front())
    left = 0
    right = k
    while right < len(nums):
        sinq.pop(nums[left])
        left += 1
        sinq.push(nums[right])
        right += 1
        ans.append(sinq.front())
    return ans

nums = [1,3,-1,-3,5,3,6,7]
k = 3

print(singleMax(nums, k))
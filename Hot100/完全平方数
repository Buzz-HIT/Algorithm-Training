import math
def numSquares(n):
        """
        :type n: int
        :rtype: int
        """
        coins = []
        for i in range(int(math.sqrt(n))):
            coins.append((i+1) * (i+1))
        dp = [float("inf")] * (n + 1)
        dp[0] = 0
        for i in range(len(coins)):
            for j in range(1, n + 1):
                if j >= coins[i]:
                    dp[j] = min(dp[j], dp[j - coins[i]] + 1)
        if dp[n] == float("inf"):
            return -1
        return dp[n]
            